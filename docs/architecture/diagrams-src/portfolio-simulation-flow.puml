@startuml portfolio-simulation-flow

skinparam backgroundColor #fdfdfd
skinparam packageStyle rectangle
skinparam shadowing true
' Fuerza la disposición de arriba hacia abajo
top to bottom direction 

title Ares-Nexus: Institutional Portfolio Simulation Flow ($5.5B Portfolio)

actor "System Engineer" as user

package "Simulation Layer" {
    component [Synthetic Portfolio Generator] as generator <<C#>>
    component [Transaction Simulator] as simulator <<C#>>
    database "Synthetic Dataset" as dataset {
        artifact accounts.json
        artifact positions.json
        artifact transactions.json
    }
}

' Forzamos que este paquete esté debajo del anterior
"Simulation Layer" --[hidden]down-- "Ares-Nexus Architecture"

package "Ares-Nexus Architecture" {
    component [Gateway API] as gateway <<ASP.NET Core>>
    component [Settlement Core] as core <<Deterministic>>
    component [Compliance Engine] as compliance
    queue "RabbitMQ Bus" as bus
    database "Event Store" as es <<Marten/PostgreSQL>>
    
    package "AI Observability Layer" {
        component [FraudAgent] as fraud
        component [RiskAgent] as risk
        component [ComplianceAgent] as compAgent
        component [Decision Gate] as gate
    }
}

' Forzamos que este paquete esté debajo de la arquitectura
"Ares-Nexus Architecture" --[hidden]down-- "Monitoring & Observability"

package "Monitoring & Observability" {
    component [Prometheus] as prom
    component [Grafana] as grafana
}

' --- FLUJOS VERTICALES ---
user -down-> generator : make demo-portfolio
generator -down-> dataset : Generate accounts/positions/transactions
dataset -down-> simulator : Read transactions

simulator -down-> gateway : POST /api/v1/transactions

gateway -down-> compliance : Validate PII/Swiss Secrecy
compliance -down-> core : Execute Deterministic Action
core -down-> es : Store Event
core -down-> bus : Publish Event

bus -down-> fraud : Observe Event
bus -down-> risk : Observe Event
bus -down-> compAgent : Observe Event

fraud -down-> gate : Recommendation
risk -down-> gate : Recommendation
compAgent -down-> gate : Recommendation

' Conexiones a monitoreo (también hacia abajo)
core -down-> prom : Emit Metrics
simulator -down-> prom : Observe Throughput
prom -down-> grafana : Visualize Simulation State

@enduml
